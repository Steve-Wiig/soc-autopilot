179: def shannon_entropy(data: str) -> float:
180:     """Calculate Shannon entropy of a string."""
181:     if not data:
182:         return 0.0
183:     entropy = 0.0
184:     for x in range(256):
185:         p_x = data.count(chr(x)) / len(data)
186:         if p_x > 0:
187:             entropy += -p_x * math.log2(p_x)
188:     return entropy
189: 
190: 
191: def is_high_entropy(value: str, threshold: float = ENTROPY_THRESHOLD, min_length: int = MIN_ENTROPY_LENGTH) -> bool:
192:     """Check if a string has high entropy (likely encoded/encrypted)."""
193:     if not isinstance(value, str) or len(value) < min_length:
194:         return False
195:     return shannon_entropy(value) > threshold
196: 
