1: """
2: Regression test for Improvement #2: TDD Red Phase Verification
3: 
4: BEFORE: Generated TDD tests were accepted without verifying they fail.
5: PROBLEM: Vacuous tests (always pass) create false-positive fixes.
6: CHANGE: Run pytest on the generated test. If it passes immediately,
7:         reject it. Only accept tests that fail (Red phase confirmed).
8: """
9: import sys
10: from pathlib import Path
11: from unittest.mock import patch
12: 
13: import pytest
14: 
15: sys.path.insert(0, str(Path(__file__).parent.parent.parent))
16: 
17: 
18: @pytest.fixture
19: def tdd_env(tmp_path):
20:     (tmp_path / "overnight").mkdir()
21:     (tmp_path / "tests").mkdir()
22:     src = tmp_path / "dummy_module.py"
23:     src.write_text("def dummy():\n    return 42\n")
24:     return tmp_path, src
25: 
26: 
27: def test_vacuous_tdd_test_rejected(tdd_env):
28:     """A TDD test that passes immediately must be rejected (not red).
29: 
30:     Flow: baseline FAILS -> TDD generated -> red phase check PASSES -> reject test.
31:     """
32:     tmp_path, src = tdd_env
33: 
34:     issue = {"category": "correctness", "description": "dummy bug"}
35:     fake_test = "def test_always_passes():\n    assert True\n"
36: 
37:     call_count = {"n": 0}
38: 
39:     def mock_run_pytest(targets, timeout=60):
40:         call_count["n"] += 1
41:         if call_count["n"] == 1:
42:             return "AssertionError: baseline failure"  # Baseline FAILS -> proceed to TDD
43:         return None  # Red phase check PASSES -> test is vacuous -> reject
44: 
45:     with patch("overnight.self_improver.ROOT", tmp_path), \
46:          patch("overnight.self_improver._get_repo_fingerprint", return_value="unique-test-fp"), \
47:          patch("overnight.self_improver.run_pytest", side_effect=mock_run_pytest), \
48:          patch("overnight.self_improver.is_ast_defeated", return_value=False), \
49:          patch("overnight.self_improver._generate_tdd_test", return_value=fake_test):
50: 
51:         from overnight.self_improver import apply_auto_fix
52:         apply_auto_fix(src, issue, api_keys={})
53: 
54:     # The vacuous test file must have been deleted
55:     test_file = tmp_path / "tests" / "test_tdd_auto_dummy_module.py"
56:     assert not test_file.exists(), "Vacuous TDD test should have been rejected and deleted"
57: 
58: 
59: def test_valid_tdd_test_accepted(tdd_env):
60:     """A TDD test that fails (red phase) must be accepted as acceptance criteria.
61: 
62:     Flow: baseline FAILS -> TDD generated -> red phase check FAILS -> keep test.
63:     """
64:     tmp_path, src = tdd_env
65: 
66:     issue = {"category": "correctness", "description": "dummy bug"}
67:     fake_test = "def test_should_fail():\n    assert False\n"
68: 
69:     call_count = {"n": 0}
70: 
71:     def mock_run_pytest(targets, timeout=60):
72:         call_count["n"] += 1
73:         if call_count["n"] == 1:
74:             return "AssertionError: baseline failure"  # Baseline FAILS -> proceed to TDD
75:         return "AssertionError: expected failure"  # Red phase FAILS -> test is valid -> keep
76: 
77:     with patch("overnight.self_improver.ROOT", tmp_path), \
78:          patch("overnight.self_improver._get_repo_fingerprint", return_value="unique-test-fp"), \
79:          patch("overnight.self_improver.run_pytest", side_effect=mock_run_pytest), \
80:          patch("overnight.self_improver.is_ast_defeated", return_value=False), \
81:          patch("overnight.self_improver._generate_tdd_test", return_value=fake_test), \
82:          patch("overnight.self_improver.generate", return_value=None):  # Stop generation loop
83: 
84:         from overnight.self_improver import apply_auto_fix
85:         apply_auto_fix(src, issue, api_keys={})
86: 
87:     # The valid test file must still exist (not deleted)
88:     test_file = tmp_path / "tests" / "test_tdd_auto_dummy_module.py"
89:     assert test_file.exists(), "Valid TDD test (red phase confirmed) should be kept"

