46: def _load_json(path):
47:     try: return json.loads(path.read_text()) if path.exists() else []
48:     except Exception: return []
49: 
50: def _save_json(path, data): path.write_text(json.dumps(data, indent=2))
51: 
52: # ============================================================
53: # PYTEST CACHING (Improvement #4)
54: # Memoizes pytest results by (repo_fingerprint, targets).
55: # Invalidates when a fix is committed via Shadow Canary.
56: # ============================================================
57: _baseline_cache = {"fingerprint": None, "result": None, "targets": None}
58: 
59: def _get_repo_fingerprint():
60:     """Hash relevant repo files (tracked + untracked) to detect state changes.
61:     
62:     Includes full file content (not truncated) and untracked files to prevent
63:     false cache hits when test/engine code changes beyond the 4KB mark or
64:     when new untracked test files are added.
65:     """
66:     try:
67:         # Get tracked files
68:         res1 = subprocess.run(
69:             ["git", "ls-tree", "-r", "HEAD", "--name-only"],
70:             capture_output=True, text=True, cwd=ROOT, timeout=10
71:         )
72:         tracked = set(f.strip() for f in res1.stdout.splitlines() if f.strip()) if res1.returncode == 0 else set()
73: 
74:         # Get untracked files (respecting .gitignore)
75:         res2 = subprocess.run(
76:             ["git", "ls-files", "--others", "--exclude-standard"],
77:             capture_output=True, text=True, cwd=ROOT, timeout=10
78:         )
79:         untracked = set(f.strip() for f in res2.stdout.splitlines() if f.strip()) if res2.returncode == 0 else set()
80: 
81:         # Only hash relevant code directories to avoid invalidating cache on docs/README changes
82:         relevant_prefixes = ("tests/", "engine/", "overnight/", "memory/", "orchestrator/", "tools/")
83:         
84:         h = hashlib.sha256()
85:         for f in sorted(tracked | untracked):
86:             if not any(f.startswith(p) for p in relevant_prefixes):
87:                 continue
88:             h.update(f.encode())
89:             p_file = ROOT / f
90:             if p_file.exists():
91:                 h.update(p_file.read_bytes())
92:             else:
93:                 h.update(b"__DELETED__")
94:         return h.hexdigest()
95:     except Exception:
96:         return None
97: 
98: 
99: 
100: def run_pytest_cached(targets, timeout=60):
101:     """Cached pytest for baseline checks. Sniper Scope must use uncached run_pytest."""
102:     fp = _get_repo_fingerprint()
103:     targets_key = tuple(sorted(targets))
104:     
105:     if (fp is not None and
106:         _baseline_cache["fingerprint"] == fp and 
107:         _baseline_cache["targets"] == targets_key):
108:         print(f"       ♻️  pytest cache hit (fingerprint: {fp[:8] if fp else 'none'}...)")
109:         return _baseline_cache["result"]
110:     
111:     result = run_pytest(targets, timeout=timeout)
112:     _baseline_cache.update({
113:         "fingerprint": fp, 
114:         "result": result, 
115:         "targets": targets_key
116:     })
117:     return result
118: 
119: 
