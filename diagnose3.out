1: import ast, hashlib, json, os, re, subprocess, sys
2: from pathlib import Path
3: 
4: PROJECT_ROOT = Path("/home/swiig/Documents/soc-autopilot")
5: EVIDENCE_DIR   = PROJECT_ROOT / "overnight" / "evidence"
6: EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)
7: 
8: class VerifierResult:
9:     def __init__(self, task_id, passed, checks, evidence_hash, notes=""):
10:         self.task_id, self.passed, self.checks = task_id, passed, checks
11:         self.evidence_hash, self.notes = evidence_hash, notes
12: 
13: def verify_python_syntax(filepath):
14:     try:
15:         with open(filepath, 'r') as f: ast.parse(f.read())
16:         return True, "syntax valid"
17:     except SyntaxError as e: return False, f"syntax error: {e}"
18:     except FileNotFoundError: return False, "file not found"
19: 
20: def verify_no_hallucinated_imports(filepath):
21:     try:
22:         with open(filepath, 'r') as f: tree = ast.parse(f.read())
23:     except: return True, "skipped"
24:     from pathlib import Path
25:     p = Path(filepath)
26:     own_pkg = ""
27:     for parent in ("engine", "orchestrator", "memory", "tools", "tests"):
28:         if parent in p.parts:
29:             own_pkg = parent
30:             break
31:     suspicious = []
32:     for node in ast.walk(tree):
33:         if isinstance(node, ast.ImportFrom) and node.module:
34:             mod = node.module
35:             if mod.startswith(("engine.", "orchestrator.", "memory.")):
36:                 if mod.split(".")[0] == own_pkg:
37:                     continue
38:                 suspicious.append(mod)
39:     return (False, f"hallucinated imports: {suspicious}") if suspicious else (True, "clean")
40: def verify_exit_codes(filepath):
41:     try:
42:         with open(filepath, 'r') as f: text = f.read()
43:     except: return False, "file not found"
44:     has_exit = "exit" in text.lower() or "if __name__" in text or "def main" in text
45:     has_0 = "0" in text
46:     has_1 = "1" in text
47:     return (True, "exit codes present") if (has_exit and has_0 and has_1) else (False, "missing exit codes")
48: def verify_no_secrets(content):
49:     patterns = [(r"AKIA[0-9A-Z]{16}", "AWS key"), (r"ghp_[A-Za-z0-9]{36}", "GitHub token"), (r"-----BEGIN [A-Z ]*PRIVATE KEY-----", "Private Key")]
50:     for pat, name in patterns:
51:         if re.search(pat, content) and "EXAMPLE" not in content and "REDACTED" not in content:
52:             return False, f"potential {name} found"
53:     return True, "no secrets"
54: 
55: def verify_task(task, output_path):
56:     checks, all_passed = [], True
57:     if not os.path.isfile(output_path):
58:         return VerifierResult(task["id"], False, [{"check":"exists","passed":False}], "0", "file missing")
59: 
60:     with open(output_path, 'r') as f: content = f.read()
61: 
62:     if output_path.endswith('.py'):
63:         ok, msg = verify_python_syntax(output_path)
64:         checks.append({"check":"syntax","passed":ok,"detail":msg}); all_passed = all_passed and ok
65:         ok, msg = verify_no_hallucinated_imports(output_path)
66:         checks.append({"check":"imports","passed":ok,"detail":msg}); all_passed = all_passed and ok
67:         if task["type"] == "implement_tool":
68:             ok, msg = verify_exit_codes(output_path)
69:             checks.append({"check":"exit_codes","passed":ok,"detail":msg}); all_passed = all_passed and ok
70: 
71:     ok, msg = verify_no_secrets(content)
72:     checks.append({"check":"secrets","passed":ok,"detail":msg}); all_passed = all_passed and ok
73: 
74:     ok = len(content.split('\n')) >= 10
75:     checks.append({"check":"min_length","passed":ok,"detail":f"{len(content.split(chr(10)))} lines"}); all_passed = all_passed and ok
76: 
77:     evidence = json.dumps(checks)
78:     h = hashlib.sha256(evidence.encode()).hexdigest()[:16]
79:     (EVIDENCE_DIR / f"{task['id']}_{h}.json").write_text(evidence)
80:     return VerifierResult(task["id"], all_passed, checks, h, "passed" if all_passed else "failed checks")

=== FILE: overnight/openrouter_quota.py ===
1: #!/usr/bin/env python3
2: """
3: OpenRouter quota tracker for the 50 RPD free-tier hard limit.
4: 
5: - Tracks every attempt (success AND 429 — both count against quota)
6: - Locks OpenRouter for 24h once exhausted
7: - Auto-resets on calendar day rollover
8: - Persists to disk so it survives restarts
9: """
10: import json
11: import os
12: from datetime import datetime, timedelta, timezone
13: from pathlib import Path
14: 
15: QUOTA_FILE = Path(__file__).resolve().parent / "openrouter_quota.json"
16: DAILY_LIMIT = 1000  # Funded tier (was 50 for free tier)
17: LOCK_HOURS = 1  # Funded tier: 1h lock on 429 (was 24h for free tier)
18: 
19: 
20: def _load():
21:     if QUOTA_FILE.exists():
22:         try:
23:             return json.loads(QUOTA_FILE.read_text())
24:         except Exception:
25:             pass
26:     return {"used_today": 0, "day": datetime.now(timezone.utc).strftime("%Y-%m-%d"), "locked_until": None}
27: 
28: 
29: def _save(data):
30:     QUOTA_FILE.parent.mkdir(parents=True, exist_ok=True)
31:     tmp = QUOTA_FILE.parent / (QUOTA_FILE.name + ".tmp")
32:     tmp.write_text(json.dumps(data, indent=2))
33:     os.replace(tmp, QUOTA_FILE)  # atomic swap
34: 
35: 
36: def _refresh(data):
37:     """Reset counter on new day; clear expired lock."""
38:     today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
39:     if data.get("day") != today:
40:         data = {"used_today": 0, "day": today, "locked_until": None}
41:     if data.get("locked_until"):
42:         try:
43:             lock_dt = datetime.fromisoformat(data["locked_until"])
44:             if lock_dt.tzinfo is None:
45:                 lock_dt = lock_dt.replace(tzinfo=timezone.utc)  # legacy naive stamps
46:             if lock_dt <= datetime.now(timezone.utc):
47:                 data["locked_until"] = None
48:         except Exception:
49:             data["locked_until"] = None
50:     return data
51: 
52: 
53: def remaining():
54:     return max(0, DAILY_LIMIT - _refresh(_load()).get("used_today", 0))
55: 
56: 
57: def is_available():
58:     """True if OpenRouter can be used right now."""
59:     data = _refresh(_load())
60:     if data.get("locked_until"):
61:         return False
62:     if data.get("used_today", 0) >= DAILY_LIMIT:
63:         data["locked_until"] = (datetime.now(timezone.utc) + timedelta(hours=LOCK_HOURS)).isoformat()
64:         _save(data)
65:         return False
66:     return True
67: 
68: 
69: def record_attempt():
70:     """Count one request (success or 429). Lock when exhausted."""
71:     data = _refresh(_load())
72:     data["used_today"] = data.get("used_today", 0) + 1
73:     data["last_attempt"] = datetime.now(timezone.utc).isoformat()
74:     if data["used_today"] >= DAILY_LIMIT and not data.get("locked_until"):
75:         data["locked_until"] = (datetime.now(timezone.utc) + timedelta(hours=LOCK_HOURS)).isoformat()
76:         print(f"    🔒 OpenRouter quota exhausted ({data['used_today']}/{DAILY_LIMIT}). Locked 24h.")
77:     _save(data)
78:     return data
79: 
80: 
81: def status():
82:     d = _refresh(_load())
83:     return {
84:         "used_today": d.get("used_today", 0),
85:         "remaining": remaining(),
86:         "locked_until": d.get("locked_until"),
87:         "day": d.get("day"),
88:     }
89: 
90: 
91: def force_lock(reason="429 received"):
92:     """Instantly lock OpenRouter for 24h (used when we hit a 429)."""
93:     data = _refresh(_load())
94:     data["locked_until"] = (datetime.now(timezone.utc) + timedelta(hours=LOCK_HOURS)).isoformat()
95:     data["lock_reason"] = reason
96:     # Mark as fully used so it stays locked even if time resets
97:     data["used_today"] = DAILY_LIMIT 
98:     _save(data)
99:     print(f"    🔒 OpenRouter force-locked for 24h ({reason})")
100: 
101: 
102: 
103: if __name__ == "__main__":
104:     s = status()
105:     print(f"OpenRouter quota: {s['used_today']}/{DAILY_LIMIT} used, {s['remaining']} remaining")
106:     print(f"Locked until: {s['locked_until'] or 'not locked'}")
107: 

=== FILE: overnight/budget_manager.py ===
1: #!/usr/bin/env python3
2: """
3: API Budget Manager for soc-autopilot.
4: 
5: Tracks per-minute, per-hour, and per-day API usage for both providers.
6: Enforces free-tier limits and gracefully pauses/stops when budget is low.
7: 
8: Usage in any automation script:
9:     from overnight.budget_manager import APIBudgetManager
10:     
11:     budget = APIBudgetManager()
12:     
13:     if not budget.can_proceed("openrouter"):
14:         print("Budget exhausted, stopping")
15:         sys.exit(0)
16:     
17:     budget.record_call("openrouter")
18:     # ... make the API call ...
19: 
20: CLI:
21:     python3 overnight/budget_manager.py              # Show current usage
22:     python3 overnight/budget_manager.py --reset      # Reset all counters
23: """
24: import json
25: import os
26: import time
27: from collections import deque
28: from datetime import datetime, timedelta
29: from pathlib import Path
30: from typing import Dict, Optional
31: 
32: ROOT = Path("/home/swiig/Documents/soc-autopilot")
33: USAGE_FILE = ROOT / "overnight" / "api_usage.json"
34: 
35: # ============================================================
36: # FREE TIER LIMITS (adjust these to match your actual limits)
37: # ============================================================
38: # Check your actual limits at:
39: #   OpenRouter: https://openrouter.ai/settings/limits
40: #   Gemini: https://ai.google.dev/gemini-api/docs/rate-limits
41: #
42: # Conservative defaults — adjust upward if your tier allows more.
43: LIMITS = {
44:     "openrouter": {
45:         "per_minute": 20,
46:         "per_hour": 200,
47:         "per_day": 500,
48:     },
49:     "gemini": {
50:         "per_minute": 15,
51:         "per_hour": 300,
52:         "per_day": 1000,
53:     },
54:     "groq": {
55:         "per_minute": 30,       # RPM: 30 requests per minute (all models)
56:         "per_hour": 1500,       # Conservative: ~25 RPM sustained
57:         "per_day": 250,         # RPD: 250 requests per day (groq/compound)
58:     },
59:     "mistral": {
60:         "per_minute": 15,
61:         "per_hour": 300,
62:         "per_day": 1000,
63:     },
64:     "groq_alt": {
65:         "per_minute": 30,       # RPM: 30 requests per minute
66:         "per_hour": 1500,       # Conservative
67:         "per_day": 1000,        # RPD: 1000 requests per day (gpt-oss-*, qwen3.6)
68:     },
69: }
70: 
71: # How much buffer to leave before stopping (percentage)
72: SAFETY_MARGIN = 0.85  # Stop at 85% of limit to avoid hitting 429
73: 
74: 
75: class APIBudgetManager:
76:     """Tracks and enforces API usage limits across providers."""
77: 
78:     def __init__(self, limits: Optional[Dict] = None):
79:         self.limits = limits or LIMITS
80:         self.usage_file = USAGE_FILE
81:         self._usage = self._load_usage()
82: 
83:     # ============================================================
84:     # PERSISTENCE
85:     # ============================================================
86:     def _load_usage(self) -> Dict:
87:         """Load usage history from disk."""
88:         if self.usage_file.exists():
89:             try:
90:                 data = json.loads(self.usage_file.read_text())
91:                 # Convert lists back to deques with datetime objects
92:                 usage = {}
93:                 for provider, timestamps in data.items():
94:                     usage[provider] = deque(
95:                         datetime.fromisoformat(ts) for ts in timestamps
96:                     )
97:                 return usage
98:             except (json.JSONDecodeError, ValueError):
99:                 pass
100:         return {provider: deque() for provider in self.limits}
101: 
102:     def _save_usage(self):
103:         """Persist usage history to disk."""
104:         self.usage_file.parent.mkdir(parents=True, exist_ok=True)
105:         data = {}
106:         for provider, timestamps in self._usage.items():
107:             data[provider] = [ts.isoformat() for ts in timestamps]
108:         self.usage_file.write_text(json.dumps(data, indent=2))
109: 
110:     # ============================================================
111:     # USAGE TRACKING
112:     # ============================================================
113:     def _cleanup_old(self, provider: str):
114:         """Remove timestamps older than 24 hours."""
115:         cutoff = datetime.now() - timedelta(hours=24)
116:         usage = self._usage.get(provider, deque())
117:         while usage and usage[0] < cutoff:
118:             usage.popleft()
119:         self._usage[provider] = usage
120: 
121:     def record_call(self, provider: str):
122:         """Record a single API call."""
123:         self._cleanup_old(provider)
124:         if provider not in self._usage:
125:             self._usage[provider] = deque()
126:         self._usage[provider].append(datetime.now())
127:         self._save_usage()
128: 
129:     def _count_in_window(self, provider: str, window_minutes: int) -> int:
130:         """Count calls within the last N minutes."""
131:         self._cleanup_old(provider)
132:         cutoff = datetime.now() - timedelta(minutes=window_minutes)
133:         usage = self._usage.get(provider, deque())
134:         return sum(1 for ts in usage if ts >= cutoff)
135: 
136:     # ============================================================
137:     # BUDGET CHECKS
138:     # ============================================================
139:     def get_usage(self, provider: str) -> Dict[str, int]:
140:         """Get current usage counts for all windows."""
141:         self._cleanup_old(provider)
142:         return {
143:             "last_minute": self._count_in_window(provider, 1),
144:             "last_hour": self._count_in_window(provider, 60),
145:             "last_day": self._count_in_window(provider, 1440),
146:         }
147: 
148:     def get_remaining(self, provider: str) -> Dict[str, int]:
149:         """Get remaining budget for all windows."""
150:         usage = self.get_usage(provider)
151:         limits = self.limits.get(provider, {})
152:         return {
153:             "per_minute": max(0, limits.get("per_minute", 0) - usage["last_minute"]),
154:             "per_hour": max(0, limits.get("per_hour", 0) - usage["last_hour"]),
155:             "per_day": max(0, limits.get("per_day", 0) - usage["last_day"]),
156:         }
157: 
158:     def get_limits_for_model(self, model: str = None) -> Dict:
159:         """Get rate limits for a specific Groq model.
160:         
161:         groq/compound and groq/compound-mini: 250 RPD
162:         gpt-oss-*, qwen3.6: 1000 RPD
163:         """
164:         if model and 'groq/compound' in model:
165:             return self.limits.get('groq', self.limits['groq'])
166:         elif model and ('gpt-oss' in model or 'qwen' in model):
167:             return self.limits.get('groq_alt', self.limits['groq'])
168:         else:
169:             return self.limits.get('groq', self.limits['groq'])
170:     
171:     def can_proceed_model_aware(self, provider: str, model: str = None) -> bool:
172:         """Check if we can proceed, taking model-specific limits into account."""
173:         if provider != 'groq':
174:             return self.can_proceed(provider)
175:         
176:         now = datetime.now()
177:         calls = list(self._usage.get(provider, deque()))
178:         limits = self.get_limits_for_model(model)
179:         
180:         # Check per-minute
181:         minute_cutoff = now - timedelta(minutes=1)
182:         minute_calls = [c for c in calls if c > minute_cutoff]
183:         if len(minute_calls) >= limits['per_minute']:
184:             return False
185:         
186:         # Check per-hour
187:         hour_cutoff = now - timedelta(hours=1)
188:         hour_calls = [c for c in calls if c > hour_cutoff]
189:         if len(hour_calls) >= limits['per_hour']:
190:             return False
191:         
192:         # Check per-day
193:         day_cutoff = now - timedelta(hours=24)
194:         day_calls = [c for c in calls if c > day_cutoff]
195:         if len(day_calls) >= limits['per_day']:
196:             return False
197:         
198:         return True
199:     
200:     def wait_if_needed_model_aware(self, provider: str, model: str = None, timeout: int = 120) -> bool:
201:         """Model-aware precise wait for Groq; delegates for other providers."""
202:         if provider != "groq":
203:             return self.wait_if_needed(provider, timeout)
204:         import time
205:         waited = 0.0
206:         limits = self.get_limits_for_model(model)
207:         while waited < timeout:
208:             if self.can_proceed_model_aware(provider, model):
209:                 return True
210:             if self._seconds_until_slot(provider, 86400, limits["per_day"]) > 0:
211:                 print(f"  🔒 [groq/{model or 'any'}] daily limit reached — no more calls this window")
212:                 return False
213:             waits = [self._seconds_until_slot(provider, 60, limits["per_minute"]),
214:                      self._seconds_until_slot(provider, 3600, limits["per_hour"])]
215:             full = [w for w in waits if w > 0]
216:             sleep_time = min(full) if full else 1.0
217:             sleep_time = min(sleep_time, max(0.5, timeout - waited))
218:             print(f"  ⏱️  [groq/{model or 'any'}] rate window full — sleeping {sleep_time:.1f}s")
219:             time.sleep(sleep_time)
220:             waited += sleep_time
221:         return False
222:     def can_proceed(self, provider: str) -> bool:
223:         """Check if we can make another call without exceeding limits."""
224:         usage = self.get_usage(provider)
225:         limits = self.limits.get(provider, {})
226: 
227:         for window, key in [
228:             ("per_minute", "last_minute"),
229:             ("per_hour", "last_hour"),
230:             ("per_day", "last_day"),
231:         ]:
232:             limit = limits.get(window, float("inf"))
233:             current = usage[key]
234:             threshold = int(limit * SAFETY_MARGIN)
235:             if current >= threshold:
236:                 return False
237: 
238:         return True
239: 
240:     def _seconds_until_slot(self, provider, window_seconds, max_calls):
241:         """Exact seconds until a slot frees in a sliding window (0.0 if open)."""
242:         now = datetime.now()
243:         cutoff = now - timedelta(seconds=window_seconds)
244:         stamps = [ts for ts in self._usage.get(provider, deque()) if ts > cutoff]
245:         # Apply SAFETY_MARGIN to match can_proceed() threshold logic
246:         effective_max = int(max_calls * SAFETY_MARGIN)
247:         if len(stamps) < effective_max:
248:             return 0.0
249:         oldest = min(stamps)
250:         return max(0.0, window_seconds - (now - oldest).total_seconds()) + 0.25
251:     def wait_if_needed(self, provider: str, timeout: int = 120) -> bool:
252:         """Sleep precisely until a rate slot opens (no 1s polling spam)."""
253:         import time
254:         waited = 0.0
255:         limits = self.limits.get(provider, self.limits.get("groq"))
256:         while waited < timeout:
257:             if self.can_proceed(provider):
258:                 return True
259:             if self._seconds_until_slot(provider, 86400, limits["per_day"]) > 0:
260:                 print(f"  🔒 [{provider}] daily limit reached — no more calls this window")
261:                 return False
262:             waits = [self._seconds_until_slot(provider, 60, limits["per_minute"]),
263:                      self._seconds_until_slot(provider, 3600, limits["per_hour"])]
264:             full = [w for w in waits if w > 0]
265:             sleep_time = min(full) if full else 1.0
266:             sleep_time = min(sleep_time, max(0.5, timeout - waited))
267:             print(f"  ⏱️  [{provider}] rate window full — sleeping {sleep_time:.1f}s until a slot opens")
268:             time.sleep(sleep_time)
269:             waited += sleep_time
270:         return False
271:     def _oldest_in_window(self, provider: str, window_minutes: int) -> Optional[datetime]:
272:         """Get the oldest timestamp in the window."""
273:         cutoff = datetime.now() - timedelta(minutes=window_minutes)
274:         usage = self._usage.get(provider, deque())
275:         for ts in usage:
276:             if ts >= cutoff:
277:                 return ts
278:         return None
279: 
280:     # ============================================================
281:     # REPORTING
282:     # ============================================================
283:     def report(self) -> str:
284:         """Generate a human-readable usage report."""
285:         lines = ["=" * 60]
286:         lines.append("API USAGE REPORT")
287:         lines.append("=" * 60)
288: 
289:         for provider, limits in self.limits.items():
290:             usage = self.get_usage(provider)
291:             remaining = self.get_remaining(provider)
292: 
293:             lines.append(f"\n  {provider.upper()}:")
294:             lines.append(f"    Last minute: {usage['last_minute']:3d} / {limits.get('per_minute', '?')} "
295:                         f"(remaining: {remaining['per_minute']})")
296:             lines.append(f"    Last hour:   {usage['last_hour']:3d} / {limits.get('per_hour', '?')} "
297:                         f"(remaining: {remaining['per_hour']})")
298:             lines.append(f"    Last 24h:    {usage['last_day']:3d} / {limits.get('per_day', '?')} "
299:                         f"(remaining: {remaining['per_day']})")
300: 
301:             # Status indicator
302:             can_go = self.can_proceed(provider)
303:             status = "✅ READY" if can_go else "⚠️  PAUSED (limit approaching)"
304:             lines.append(f"    Status:      {status}")
305: 
306:         lines.append("\n" + "=" * 60)
307:         return "\n".join(lines)
308: 
309:     def reset(self):
310:         """Reset all usage counters."""
311:         self._usage = {provider: deque() for provider in self.limits}
312:         self._save_usage()
313: 
314: 
315: # ============================================================
316: # CONVENIENCE: Decorator for budget-aware API calls
317: # ============================================================
318: def budget_aware(provider: str, max_wait: int = 120):
319:     """
320:     Decorator that enforces budget limits before calling an API function.
321:     
322:     Usage:
323:         budget = APIBudgetManager()
324:         
325:         @budget_aware("openrouter")
326:         def my_api_call(prompt):
327:             ...
328:     """
329:     def decorator(func):
330:         def wrapper(*args, **kwargs):
331:             budget = APIBudgetManager()
332:             if not budget.wait_if_needed(provider, timeout=max_wait):
333:                 raise RuntimeError(
334:                     f"API budget exhausted for {provider}. "
335:                     f"Try again later or increase limits."
336:                 )
337:             result = func(*args, **kwargs)
338:             budget.record_call(provider)
339:             return result
340:         wrapper.__name__ = func.__name__
341:         wrapper.__doc__ = func.__doc__
342:         return wrapper
343:     return decorator
344: 
345: 
346: # ============================================================
347: # CLI
348: # ============================================================
349: if __name__ == "__main__":
350:     import argparse
351: 
352:     parser = argparse.ArgumentParser(description="API Budget Manager")
353:     parser.add_argument("--reset", action="store_true", help="Reset all usage counters")
354:     parser.add_argument("--json", action="store_true", help="Output as JSON")
355:     args = parser.parse_args()
356: 
357:     budget = APIBudgetManager()
358: 
359:     if args.reset:
360:         budget.reset()
361:         print("✅ All usage counters reset")
362:     else:
363:         if args.json:
364:             usage = {
365:                 provider: budget.get_usage(provider)
366:                 for provider in budget.limits
367:             }
368:             remaining = {
369:                 provider: budget.get_remaining(provider)
370:                 for provider in budget.limits
371:             }
372:             print(json.dumps({"usage": usage, "remaining": remaining}, indent=2))
373:         else:
374:             print(budget.report())

