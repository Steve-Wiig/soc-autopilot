209:         return obj
210:     elif isinstance(obj, list):
211:         for i, v in enumerate(obj):
212:             obj[i] = sanitize_recursive(v)
213:         return obj
214:     else:
215:         return obj
216:         return redact_value(obj)
217: 
218: 
219: def sanitize_value(value: Any) -> Any:
220:     """Sanitize a single value."""
221:     return sanitize_recursive(value)
