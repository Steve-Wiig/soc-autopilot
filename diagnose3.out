487: # Symmetric counterpart to proven_fix memory (positive learning).
488: # ============================================================
489: FAILED_FIXES_PATH = ROOT / "overnight" / "failed_fixes.jsonl"
490: 
491: def _store_failed_fix(file_path, issue, diff_text, constraint):
492:     """Store a failed fix attempt as a negative pattern to avoid."""
493:     try:
494:         entry = {
495:             "timestamp": datetime.now().isoformat(),
496:             "category": issue.get("category", "unknown"),
497:             "file": _safe_relative_path(file_path),
498:             "advisory": issue.get("description", "")[:200],
499:             "failed_diff": diff_text[:1500],
500:             "constraint": constraint[:300] if constraint else ""
501:         }
502:         with open(FAILED_FIXES_PATH, "a") as f:
503:             f.write(json.dumps(entry) + "\n")
504:     except Exception:
505:         pass  # Non-blocking
506: 
507: def _retrieve_failed_patterns(issue, max_examples=2):
508:     """Retrieve similar past failures to inject as AVOID warnings."""
509:     try:
510:         if not FAILED_FIXES_PATH.exists():
511:             return ""
512:         entries = []
513:         for line in FAILED_FIXES_PATH.read_text().strip().split("\n"):
514:             if line.strip():
515:                 try: entries.append(json.loads(line))
516:                 except Exception: pass
517:         if not entries:
518:             return ""
519:         target_category = issue.get("category", "").lower()
520:         target_words = set(issue.get("description", "").lower().split())
521:         scored = []
522:         for entry in entries:
523:             score = 0
524:             if entry.get("category", "").lower() == target_category:
525:                 score += 10
526:             overlap = len(target_words & set(entry.get("advisory", "").lower().split()))
527:             score += min(overlap, 5)
528:             if score > 0:
529:                 scored.append((score, entry))
530:         scored.sort(key=lambda x: x[0], reverse=True)
531:         top = [e for _, e in scored[:max_examples]]
532:         if not top:
533:             return ""
534:         parts = ["PAST FAILED APPROACHES (do NOT repeat these mistakes):"]
535:         for i, m in enumerate(top, 1):
536:             parts.append(f"\nFailed attempt {i} ({m.get('category')}, {m.get('file')}):")
537:             if m.get("constraint"):
538:                 parts.append(f"Why it failed: {m['constraint'][:200]}")
539:             parts.append(f"Bad patch (AVOID this pattern):\n{m.get('failed_diff', '')[:500]}")
540:         parts.append("\nLearn from these failures. Do NOT repeat the same mistakes.\n\n")
541:         return "\n".join(parts)
542:     except Exception:
543:         return ""  # Non-blocking
544: 
545: 
546: # ============================================================
547: # CORE FIX ENGINE
548: # ============================================================
549: def apply_auto_fix(file_path, issue, api_keys):
550:     try: original = file_path.read_text()
551:     except Exception: return False
552: 
553:     if is_ast_defeated(original): return False
554:     if issue.get('category', '').lower() in ['style', 'documentation']: return False
555: 
556:     targets = _get_test_targets(file_path)
557:     
558:     # 1. RED-GREEN BASELINE
559:     baseline_tb = run_pytest_cached(targets)
560:     if baseline_tb is None:
561:         category = issue.get('category', '').lower()
562:         # Functional bugs with passing tests are truly stale (already fixed)
563:         if category in ['bug', 'correctness', 'style', 'documentation', '']:
564:             print(f"       ✅ Baseline tests passed. Stale advisory.")
565:             _record_ledger(file_path, issue, "STALE", "Baseline passed")
566:             return True
567:         else:
568:             # Security/Performance/Reliability flaws don't always have failing tests.
569:             # Do not drop them. Escalate to manual review.
570:             print(f"       ⚠️ Baseline passed, but category is '{category}'. Escalating (lacks regression test).")
571:             _escalate_to_manual(file_path, issue, f"Passed baseline but lacks regression test for {category} defect.")
572:             _record_ledger(file_path, issue, "ESCALATED", "Lacks regression test")
573:             return True
574:     print(f"       🔴 Baseline failure captured ({len(baseline_tb)} chars)")
575: 
576:     # 2. TDD SUB-AGENT
577:     print(f"       🧪 Spawning TDD Sub-Agent...")
578:     tdd_test_code = _generate_tdd_test(issue.get('description', ''), str(file_path.relative_to(ROOT)), api_keys)
579:     tdd_kept_path = None
580:     tdd_block = ""
581:     if tdd_test_code:
582:         test_path = ROOT / "tests" / f"test_tdd_auto_{file_path.stem}.py"
583:         try:
584:             test_path.write_text(tdd_test_code)
585:             # RED PHASE VERIFICATION: The test MUST fail before we apply the fix.
586:             # If it passes immediately, the test is vacuous and cannot validate the fix.
587:             red_check = run_pytest([str(test_path.relative_to(ROOT))])
588:             if red_check is None:
589:                 print(f"       ⚠️ TDD Red Phase FAILED: Test passes immediately. Rejecting vacuous test.")
590:                 test_path.unlink()
591:             else:
592:                 print(f"       🔴 TDD Red Phase CONFIRMED: Test fails as expected.")
593:                 tdd_block = f"ACCEPTANCE CRITERIA (Make this test pass):\n```python\n{tdd_test_code}\n```\n\n"
594:                 tdd_kept_path = test_path
595:         except Exception: pass
596: 
597:     # 3. GENERATION LOOP
598:     critic_constraint = ""
599:     failed_attempt_1_raw = ""
600:     current_temp = 0.2
601:     current_max = 4096
602:     
603:     # FORENSIC ANALYSIS PHASE (Improvement #5)
604:     print(f"       🔬 Running forensic analysis...")
605:     forensic_context = _forensic_analysis(issue, original, baseline_tb, api_keys)
606:     api_sigs = _get_imported_signatures(file_path)
607:     
608:     # PROVEN FIX RETRIEVAL (Improvement #6)
609:     proven_examples = _retrieve_similar_fixes(issue)
610:     if proven_examples:
611:         forensic_context += proven_examples
612:         print(f"       📚 Retrieved {proven_examples.count('Example')} proven fix example(s)")
613: 
614:     # NEGATIVE MEMORY RETRIEVAL (Improvement #14)
615:     failed_patterns = _retrieve_failed_patterns(issue)
616:     if failed_patterns:
617:         forensic_context += failed_patterns
618:         print(f"       🚫 Retrieved {failed_patterns.count('Failed attempt')} failed pattern(s) to avoid")
619:     if forensic_context:
620:         print(f"       🔬 Forensic context: {forensic_context.split(chr(10))[1][:60]}...")
621:     else:
622:         print(f"       🔬 Forensic analysis unavailable (falling back to direct generation)")
623: 
624:     for attempt in range(2):
625:         pruned = _choose_context(original, issue.get('description', ''))
626:         
627:         prompt = (
628:             "You are a senior Python engineer. Fix the issue below.\n"
629:             "Output ONLY Aider-style SEARCH/REPLACE blocks.\n"
630:             "Format: <<<<<<< path/to/file.py\n[exact search text]\n=======\n[replace]\n>>>>>>> REPLACE\n\n"
631:             "CRITICAL RULES FOR THE SEARCH BLOCK:\n"
632:             "1. Copy lines EXACTLY as they appear between the ``` markers in CURRENT FILE.\n"
633:             "2. Do NOT add line numbers. Do NOT re-indent. Do NOT reformat.\n"
634:             "3. Preserve every space and newline exactly.\n\n"
635:             f"{tdd_block}"
636:             f"ISSUE: {issue.get('description', '')}\n\n"
637:             f"{forensic_context}"
638:             f"{api_sigs}"
639:             f"BASELINE TRACEBACK:\n```{baseline_tb}```\n\n"
640:             f"{f'CRITICAL STRATEGY SHIFT: {critic_constraint}' if critic_constraint else ''}\n"
641:             f"CURRENT FILE:\n```\n{pruned}\n```\n\n"
642:             f"FILE PATH: {file_path.relative_to(ROOT)}"
643:         )
644:         if attempt == 1 and failed_attempt_1_raw:
645:             prompt += f"\n\n<<<<<<< YOUR PREVIOUS FAILED ATTEMPT (DO NOT REPEAT THIS)\n{failed_attempt_1_raw[:3000]}\n>>>>>>> END FAILED ATTEMPT\n"
646:         raw = generate(prompt, api_keys, temperature=current_temp, max_tokens=current_max)
647:         if not raw: return False
648:         raw = strip_fences(raw)
649: 
650:         # Parse & Apply Patches
651:         modified_files = {}
652:         try:
653:             if parse_multi_file_diff:
654:                 patches = parse_multi_file_diff(raw, ROOT)
655:                 modified_files = apply_multi_file_patches(patches)
656:             else:
657:                 # Fallback to simple single-file replace if engine missing
658:                 modified_files = {file_path: original.replace(raw, raw)} # Dummy
659:         except Exception as e:
660:             if attempt == 0:
661:                 failed_attempt_1_raw = raw
662:                 print(f"       🩸 AUTOPSY: Analyzing patch failure...")
663:                 critic_constraint = perform_autopsy(raw, str(e), api_keys)
664:                 print(f"       🧠 Constraint: {critic_constraint[:80]}...")
665:                 # DYNAMIC TUNING
666:                 if "truncat" in critic_constraint.lower(): current_max = 8192; current_temp = 0.1
667:                 elif "algorithm" in critic_constraint.lower() or "logic" in critic_constraint.lower(): current_temp = 0.6
668:                 else: current_temp = 0.1
669:                 continue
670:             return False
671: 
672:         # GUARD: If patch produced no changes, skip pytest and retry
673:         if not modified_files:
674:             try:
675:                 (ROOT / "overnight" / "last_failed_raw.txt").write_text(
676:                     f"=== ADVISORY ===\n{issue.get('description','')}\n\n"
677:                     f"=== RAW MODEL OUTPUT (0 SEARCH/REPLACE blocks parsed) ===\n{raw[:6000]}\n")
678:             except Exception: pass
679:             print(f"       ⚠️ 0 SEARCH/REPLACE blocks parsed (format issue). Raw dumped to overnight/last_failed_raw.txt")
680:             if attempt == 0:
681:                 failed_attempt_1_raw = raw
682:                 continue
683:             return False
684: 
685:         # 👻 GHOST NAME GATE: Reject patches that use undefined names (saves Pytest runs)
686:         ghost_violations = {}
687:         for path, new_content in modified_files.items():
688:             ghosts = _check_for_ghost_names(new_content)
689:             if ghosts:
690:                 ghost_violations[path.name] = ghosts
691: 
692:         if ghost_violations:
693:             ghosts_str = ", ".join([f"{k}({', '.join(v)})" for k,v in ghost_violations.items()])
694:             print(f"       👻 GHOST NAMES DETECTED: {ghosts_str}")
695:             if attempt == 0:
696:                 failed_attempt_1_raw = raw
697:                 critic_constraint = f"Generated code uses undefined names ({ghosts_str}). Add the missing imports or use existing ones."
698:                 current_temp = 0.1
699:                 continue
700:             return False
701: 
702:         # Backup & Write
703:         backups = {}
704:         for path, content in modified_files.items():
705:             backups[path] = path.read_text() if path.exists() else ""
706:             path.write_text(content)
707: 
708:         # Run Pytest (Sniper Scope)
709:         tb = run_pytest(targets)
710:         before_ids = _failed_test_ids(baseline_tb)
711:         after_ids = _failed_test_ids(tb)
712:         new_failures = after_ids - before_ids
713:         if tdd_kept_path is not None:
714:             tdd_passes = run_pytest([str(tdd_kept_path.relative_to(ROOT))]) is None
715:             success = (len(new_failures) == 0) and tdd_passes
716:         else:
717:             success = (tb is None) or (after_ids < before_ids)
718:         print(f"       📉 Delta: before={len(before_ids)} after={len(after_ids)} new_failures={len(new_failures)}")
719:         if success:
720:             # SUCCESS -> SHADOW CANARY
721:             import uuid
722:             from tools.shadow_canary import run_canary
723:             shadow_branch = f"shadow/autofix-{uuid.uuid4().hex[:8]}"
724:             modified_paths = [str(p) for p in modified_files.keys()]
725:             
726:             try:
727:                 print(f"       🦜 Routing to Shadow Canary ({shadow_branch})...")
728:                 subprocess.run(["git", "checkout", "master"], cwd=ROOT, capture_output=True)
729:                 subprocess.run(["git", "checkout", "-b", shadow_branch], cwd=ROOT, check=True, capture_output=True)
730:                 subprocess.run(["git", "add", *modified_paths], cwd=ROOT, check=True, capture_output=True)
731:                 subprocess.run(["git", "commit", "-m", f"shadow: {file_path.name}"], cwd=ROOT, check=True, capture_output=True)
732:                 
733:                 if run_canary(modified_paths):
734:                     subprocess.run(["git", "checkout", "master"], cwd=ROOT, check=True, capture_output=True)
735:                     subprocess.run(["git", "merge", shadow_branch], cwd=ROOT, check=True, capture_output=True)
736:                     subprocess.run(["git", "branch", "-d", shadow_branch], cwd=ROOT, check=True, capture_output=True)
737:                     print(f"       🟢 CANARY PASSED: Merged to master")
738:                     # STORE PROVEN FIX (Improvement #6)
739:                     _store_proven_fix(file_path, issue, raw, forensic_context)
740:                     _record_ledger(file_path, issue, "APPLIED", "Canary passed")
741:                     return True
742:                 else:
743:                     for path, content in backups.items(): path.write_text(content)
744:                     subprocess.run(["git", "checkout", "master"], cwd=ROOT, capture_output=True)
745:                     subprocess.run(["git", "branch", "-D", shadow_branch], cwd=ROOT, capture_output=True)
746:                     print(f"       🔴 CANARY FAILED: Reverted disk and shadow branch")
747:                     return False
748:                     
749:             except Exception as e:
750:                 for path, content in backups.items(): path.write_text(content)

