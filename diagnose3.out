43: def transaction(conn: sqlite3.Connection) -> Generator[sqlite3.Cursor, None, None]:
44:     """Provide a transactional scope around a series of operations."""
45:     cursor = conn.cursor()
46:     try:
47:         yield cursor
48:         conn.commit()
49:     except Exception:
50:         conn.rollback()
51:         raise
