67: def with_db(transaction: bool = False) -> Callable[[Callable[..., T]], Callable[..., T]]:
68:     """Parameterized decorator for database operations with optional transaction handling."""
69:     def decorator(func: Callable[..., T]) -> Callable[..., T]:
70:         def wrapper(*args: Any, **kwargs: Any) -> T:
71:             try:
72:                 with get_connection() as conn:
