460:def _call_groq(prompt, api_key, model=None, system_prompt=None, max_tokens=8192, temperature=0.2):
461:    """Call Groq with cooldown tracking so we never waste requests probing
462:    models that are already rate-limited."""
467:    models = get_groq_models(api_key)
472:    models = [m for m in models if m not in BLOCKED]
473:    models.sort(key=lambda m: PREFERRED.index(m) if m in PREFERRED else len(PREFERRED))
474:    if model and model in models:
475:        models = [model] + [m for m in models if m != model]
479:    def _in_cooldown(m):
480:        return _groq_cooldown.get(m, 0) > time.time()
489:    for pass_num in range(2):  # pass 1: try ready models; pass 2: after cooldown wait
490:        for try_model in models:
491:            if _groq_preempted(try_model):
492:                continue  # server says remaining=0; don't probe until reset
